# Copy to .env and edit. Every value has a sensible default (see app/config.py) so this file is optional.

# --- Storage ---
# DATA_DIR=./data
# DB_PATH=./data/coldtrace.db
# MODELS_DIR=./models

# --- Auth ---
# JWT_SECRET is auto-generated into data/.jwt_secret on first run if unset.
# JWT_SECRET=
# JWT_TTL_MIN=720
# DEMO_PASSWORD=coldtrace

# --- Local LLM (Ollama) ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# LLM_TIMEOUT_S=60

# --- Real weather window (ERA5 reanalysis via Open-Meteo), ISO dates ---
# Defaults to the 14 days ending 6 days ago (ERA5 archive typically lags ~5 days).
# WEATHER_START=2026-08-01
# WEATHER_END=2026-08-14

# --- Optional: pull fresh Agmarknet prices instead of the bundled snapshot ---
# Get a free key at https://data.gov.in (My Account -> API Access)
# DATA_GOV_IN_API_KEY=

# --- Routing ---
# Public OSRM demo server. For heavy use, self-host OSRM or use a commercial routing API.
# OSRM_URL=https://router.project-osrm.org

# --- Replay demo pacing ---
# REPLAY_INTERVAL_S=1.0
# REPLAY_FRAMES_PER_TICK=1
