# --- Environment & Secret Credentials ---
.env
.env.*
!.env.example
*.env
**/.jwt_secret
data/.jwt_secret
**/data/.jwt_secret

# --- Python & Bytecode ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
**/.venv/
venv/
**/venv/
ENV/
env/

# --- Database & Runtime State ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db*
**/data/*.db*
data/coldtrace.db
data/coldtrace.db-wal
data/coldtrace.db-shm

# --- Machine Learning Models & Serialized Artifacts ---
models/*.joblib
**/models/*.joblib
models/model_card.json
**/models/model_card.json
*.pkl
*.onnx

