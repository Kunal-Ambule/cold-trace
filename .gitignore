.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# --- Logs & Process Output ---
*.log
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Node / Frontend (if applicable) ---
node_modules/
**/node_modules/

# --- OS & System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

